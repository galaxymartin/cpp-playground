{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug cpp-playground",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/GCC-16.2-debug/cpp-playground",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb"
        },
        {
            "name": "Debug arrow_demo",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/GCC-16.2-debug/arrow_demo",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb"
        },     
        {
            "name": "Debug tests (prompt filter)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/GCC-16.2-debug/tests",
            "args": ["--gtest_filter=${input:gtestFilter}"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb"
        }
    ],
    "inputs": [
        {
            "id": "gtestFilter",
            "type": "promptString",
            "description": "GoogleTest filter (example: MatrixTest.Multiply or MatrixTest.*)",
            "default": "*"
        }
    ]
}